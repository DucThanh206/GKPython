# Copy this file to .env and enter the OAuth Web Client values from Google Cloud.
# Do not commit .env or share its contents.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# These URLs must exactly match the authorized redirect URIs in Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/accounts/google/callback/
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:8000/accounts/google/drive/callback/
